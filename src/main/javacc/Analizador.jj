/* ======================================================================
 * Analizador.jj — Gramática JavaCC para el lenguaje tipo C#
 *
 * BLOQUE 1: LÉXICO  (TOKEN / SKIP)  → Equipo léxico
 * BLOQUE 2: SINTÁCTICO (reglas BNF) → Equipo sintáctico
 *
 * Ambos viven en este mismo archivo porque JavaCC lo requiere así.
 * Los nodos del AST se importan de com.compilador.ast.*
 * ====================================================================== */

options {
    STATIC = false;
    UNICODE_INPUT = true;
}

PARSER_BEGIN(Analizador)

package com.compilador;

import com.compilador.ast.*;
import com.compilador.errores.*;
import java.util.ArrayList;
import java.util.List;

public class Analizador {

    /** Lista de errores léxicos encontrados */
    private List<ErrorLexico> erroresLexicos = new ArrayList<ErrorLexico>();

    /** Lista de errores sintácticos encontrados */
    private List<ErrorSintactico> erroresSintacticos = new ArrayList<ErrorSintactico>();

    public List<ErrorLexico> getErroresLexicos() {
        if (!AnalizadorTokenManager.lexErrors.isEmpty()) {
            erroresLexicos.addAll(AnalizadorTokenManager.lexErrors);
            AnalizadorTokenManager.lexErrors.clear();
        }
        return erroresLexicos;
    }

    public List<ErrorSintactico> getErroresSintacticos() {
        return erroresSintacticos;
    }

    public boolean tieneErrores() {
        return !erroresLexicos.isEmpty() || !erroresSintacticos.isEmpty() || !AnalizadorTokenManager.lexErrors.isEmpty();
    }

    /** 
     * Método para recuperarse de un error sintáctico consumiendo tokens 
     * hasta encontrar un punto de sincronización (como ;, }, case, default o EOF).
     * Maneja correctamente bloques anidados con llaves.
     */
    void recuperarErrorSintactico() {
        Token t = getToken(1);
        int nivelLlaves = 0;
        while (t.kind != EOF) {
            if (t.kind == LLAVE_IZQ) {
                nivelLlaves++;
                getNextToken();
                t = getToken(1);
                continue;
            }
            if (t.kind == LLAVE_DER) {
                if (nivelLlaves > 0) {
                    nivelLlaves--;
                    getNextToken();
                    t = getToken(1);
                    continue;
                } else {
                    // Llave de cierre sin apertura: consumirla y salir
                    getNextToken();
                    return;
                }
            }
            if (nivelLlaves == 0) {
                if (t.kind == PUNTO_COMA) {
                    getNextToken();
                    return;
                }
                if (t.kind == CASE || t.kind == DEFAULT_KW) {
                    return;
                }
                if (t.kind == IF || t.kind == ELSE || t.kind == WHILE || t.kind == FOR || t.kind == DO
                    || t.kind == SWITCH || t.kind == RETURN || t.kind == BREAK
                    || t.kind == CONTINUE || esDeclaracion()) {
                    return;
                }
            }
            getNextToken();
            t = getToken(1);
        }
    }

    /** Detecta si el token actual inicia una declaración de variable (tipo de dato). */
    boolean esDeclaracion() {
        int i = 1;
        int k = getToken(i).kind;
        while (k == PUBLIC || k == PRIVATE || k == PROTECTED || k == INTERNAL || k == STATIC || k == VIRTUAL || k == OVERRIDE || k == READONLY || k == CONST) {
            i++;
            k = getToken(i).kind;
        }

        if (getToken(i+1).kind == PUNTO) return false;

        return k == INT || k == FLOAT || k == DOUBLE || k == BOOL || k == STRING_T
            || k == CHAR_T || k == VOID || k == BYTE || k == SBYTE || k == SHORT
            || k == USHORT || k == UINT || k == LONG || k == ULONG || k == DECIMAL
            || k == OBJECT || k == VAR
            || (k == IDENTIFICADOR && getToken(i+1).kind == IDENTIFICADOR)
            || (k == IDENTIFICADOR && getToken(i+1).kind == MENOR)
            || (k == IDENTIFICADOR && getToken(i+1).kind == CORCHETE_IZQ && getToken(i+2).kind == CORCHETE_DER);
    }

    /**
     * Recuperación fina: avanza hasta encontrar una llave '{' o un ';' 
     * ideal para usar cuando falla la cabecera de un método o clase.
     */
    void recuperarHastaLlave(ParseException e, String mensajeEsperado) {
        String encontrado = e.currentToken.next != null ? e.currentToken.next.image : "EOF";
        int linea = e.currentToken.next != null ? e.currentToken.next.beginLine : e.currentToken.beginLine;
        int columna = e.currentToken.next != null ? e.currentToken.next.beginColumn : e.currentToken.beginColumn;
        
        // Mejorar el mensaje si es provisto
        String mensaje = mensajeEsperado != null ? mensajeEsperado : "Error de sintaxis: " + e.getMessage();
        erroresSintacticos.add(new ErrorSintactico(encontrado, "...", mensaje, linea, columna));
        
        Token err = getToken(1);
        while (err.kind != LLAVE_IZQ && err.kind != PUNTO_COMA && err.kind != EOF) {
            getNextToken();
            err = getToken(1);
        }
    }
}

PARSER_END(Analizador)

/* ══════════════════════════════════════════════════════════════════════
 * BLOQUE 1: LÉXICO — Definición de tokens
 * ══════════════════════════════════════════════════════════════════════ */

/* --- Espacios en blanco y comentarios (se ignoran) --- */
SKIP : {
    " " | "\t" | "\n" | "\r"
}

/* Comentarios de línea */
SKIP : {
    <COMENTARIO_LINEA: "//" (~["\n","\r"])* ("\n"|"\r"|"\r\n")? >
}

/* Comentarios de documentación */
SKIP : {
    <DOC_COMENTARIO: "///" ("\n"|"\r"|"\r\n")? (~["\n","\r"])*>
}

/* Comentarios de bloque */
SKIP : {
    <COMENTARIO_BLOQUE: "/*" (~["*"])* "*" (~["/"] (~["*"])* "*")* "/" >
}

/* --- Palabras reservadas --- */
TOKEN : {
    <CONST:    "const">
  | <VAR:      "var">
  | <READONLY: "readonly">
  | <VIRTUAL:  "virtual">
  | <OVERRIDE: "override">
  | <INTERNAL: "internal">
  | <INT:      "int">
  | <FLOAT:    "float">
  | <DOUBLE:   "double">
  | <BOOL:     "bool">
  | <STRING_T: "string">
  | <CHAR_T:   "char">
  | <VOID:     "void">
  | <BYTE:     "byte">
  | <SBYTE:    "sbyte">
  | <SHORT:    "short">
  | <USHORT:   "ushort">
  | <UINT:     "uint">
  | <LONG:     "long">
  | <ULONG:    "ulong">
  | <DECIMAL:  "decimal">
  | <OBJECT:   "object">
  | <STRUCT:   "struct">
  | <INTERFACE:"interface">
  | <ENUM:     "enum">
  | <NAMESPACE:"namespace">
  | <PROTECTED:"protected">
  | <SWITCH:   "switch">
  | <CASE:     "case">
  | <DEFAULT_KW:"default">
  | <FOREACH:  "foreach">
  | <BREAK:    "break">
  | <CONTINUE: "continue">
  | <THIS:     "this">
  | <BASE:     "base">
  | <USING:    "using">
  | <TRY:      "try">
  | <CATCH:    "catch">
  | <FINALLY:  "finally">
  | <THROW:    "throw">
  | <IF:       "if">
  | <ELSE:     "else">
  | <WHILE:    "while">
  | <FOR:      "for">
  | <DO:       "do">
  | <RETURN:   "return">
  | <TRUE:     "true">
  | <FALSE:    "false">
  | <CLASS:    "class">
  | <PUBLIC:   "public">
  | <PRIVATE:  "private">
  | <STATIC:   "static">
  | <NEW:      "new">
  | <NULL:     "null">
  | <OPERATOR: "operator">
  | <OUT:      "out">
  | <REF:      "ref">
}

/* --- Operadores --- */
TOKEN : {
    <NULL_COALESCING: "??">
  | <SUMA_ASIG:     "+=">
  | <RESTA_ASIG:    "-=">
  | <MULT_ASIG:     "*=">
  | <DIV_ASIG:      "/=">
  | <MOD_ASIG:      "%=">
  | <SUMA:          "+">
  | <RESTA:         "-">
  | <MULT:          "*">
  | <DIV:           "/">
  | <MOD:           "%">
  | <ASIGNACION:    "=">
  | <IGUAL:         "==">
  | <DIFERENTE:     "!=">
  | <MENOR_IGUAL:   "<=">
  | <MAYOR_IGUAL:   ">=">
  | <MENOR:         "<">
  | <MAYOR:         ">">
  | <AND:           "&&">
  | <OR:            "||">
  | <NOT:           "!">
  | <INCREMENTO:    "++">
  | <DECREMENTO:    "--">
  | <XOR:           "^">
  | <DOS_PUNTOS:    ":">
  | <GUION_BAJO:    "_">
  | <INTERROGACION: "?">
  | <BITWISE_AND:   "&">
  | <BITWISE_OR:    "|">
  | <BITWISE_NOT:   "~">
}

/* --- Delimitadores --- */
TOKEN : {
    <PAREN_IZQ:     "(">
  | <PAREN_DER:     ")">
  | <LLAVE_IZQ:     "{">
  | <LLAVE_DER:     "}">
  | <CORCHETE_IZQ:  "[">
  | <CORCHETE_DER:  "]">
  | <PUNTO_COMA:    ";">
  | <COMA:          ",">
  | <PUNTO:         ".">
}

/* --- Literales --- */
TOKEN : {
        <NUMERO_DECIMAL_NEGATIVO: "-" (["0"-"9"])+ "." (["0"-"9"])+ (["F","f","M","m","D","d"])* >
    | <NUMERO_ENTERO_NEGATIVO:  "-" (["0"-"9"])+ (["L","l","U","u"])* >
    | <NUMERO_ENTERO:            (["0"-"9"])+ (["L","l","U","u"])* >
    | <NUMERO_DECIMAL:           (["0"-"9"])+ "." (["0"-"9"])+ (["F","f","M","m","D","d"])* >
    | <CADENA:         "\"" (~["\"","\\"] | "\\" ~[])* "\"" >
    | <CADENA_VERBATIM: "@\"" (~["\""] | "\"\"")* "\"" >
  | <CARACTER:       "'" (~["'","\\"] | "\\" ~[]) "'" >
}

/* --- Identificadores (debe ir DESPUÉS de las palabras reservadas) --- */
TOKEN : {
    <IDENTIFICADOR: ("@")? (["a"-"z","A"-"Z","_"]) (["a"-"z","A"-"Z","0"-"9","_"])* >
}

TOKEN_MGR_DECLS : {
    public static java.util.List<com.compilador.errores.ErrorLexico> lexErrors = new java.util.ArrayList<com.compilador.errores.ErrorLexico>();
}

/* --- Ignorar errores léxicos para que el parser no los reciba --- */
SKIP : {
    <IDENTIFICADOR_INVALIDO: ("@")? (["a"-"z","A"-"Z","_"]) (~[" ","\t","\n","\r","=","+","-","*","/","%","!","<",">","&","|","^",":","(",")","{","}","[","]",";",",",".","\"","'","?"])*
            (~[" ","\t","\n","\r","=","+","-","*","/","%","!","<",">","&","|","^",":","(",")","{","}","[","]",";",",",".","\"","'","0"-"9","a"-"z","A"-"Z","_","?"])
            (~[" ","\t","\n","\r","=","+","-","*","/","%","!","<",">","&","|","^",":","(",")","{","}","[","]",";",",",".","\"","'","?"])* >
    {
        lexErrors.add(new com.compilador.errores.ErrorLexico(
            image.toString(), "Identificador inválido", input_stream.getEndLine(), input_stream.getEndColumn()
        ));
    }
  | <ERROR_LEXICO: ~[]>
    {
        lexErrors.add(new com.compilador.errores.ErrorLexico(
            image.toString(), "Símbolo no reconocido en el lexema", input_stream.getEndLine(), input_stream.getEndColumn()
        ));
    }
}

/* ══════════════════════════════════════════════════════════════════════
 * BLOQUE 2: SINTÁCTICO — Reglas gramaticales (BNF)
 * Cada regla construye y devuelve nodos del AST.
 * ══════════════════════════════════════════════════════════════════════ */

/**
 * Regla principal: un programa es una secuencia de sentencias hasta EOF.
 */
NodoPrograma programa() :
{
    NodoPrograma prog = new NodoPrograma();
    Nodo s;
}
{
    (
        try {
            s = sentencia()
            { if (s != null) prog.agregarSentencia(s); }
        } catch (ParseException e) {
            String encontrado = e.currentToken.next != null ? e.currentToken.next.image : "EOF";
            int linea = e.currentToken.next != null ? e.currentToken.next.beginLine : e.currentToken.beginLine;
            int columna = e.currentToken.next != null ? e.currentToken.next.beginColumn : e.currentToken.beginColumn;
            erroresSintacticos.add(new ErrorSintactico(encontrado, "...", e.getMessage(), linea, columna));
            recuperarErrorSintactico();
        }
    )*
    try {
        <EOF>
    } catch (ParseException e) {
        String encontrado = e.currentToken.next != null ? e.currentToken.next.image : "EOF";
        int linea = e.currentToken.next != null ? e.currentToken.next.beginLine : e.currentToken.beginLine;
        int columna = e.currentToken.next != null ? e.currentToken.next.beginColumn : e.currentToken.beginColumn;
        erroresSintacticos.add(new ErrorSintactico(encontrado, "...", e.getMessage(), linea, columna));
    }
    { return prog; }
}

/**
 * Una sentencia puede ser: declaración, asignación, comando, o bloque vacío.
 */
Nodo sentencia() :
{
    Nodo n;
}
{
    (
        n = sentenciaIf()                                 { return n; }
      | n = sentenciaWhile()                              { return n; }
      | n = sentenciaDoWhile()                            { return n; }
      | n = sentenciaFor()                                { return n; }
      | n = sentenciaSwitch()                             { return n; }
      | LOOKAHEAD( ( <PUBLIC> | <PRIVATE> | <PROTECTED> | <INTERNAL> | <STATIC> | <VIRTUAL> | <OVERRIDE> | <READONLY> | <CONST> )* 
                   ( <NAMESPACE> | <USING> | <CLASS> | <INTERFACE> | <ENUM> 
                   | tipoDato() <OPERATOR> 
                   | tipoDato() <IDENTIFICADOR> <PAREN_IZQ> 
                   | <VOID> <IDENTIFICADOR> 
                   | <IDENTIFICADOR> <PAREN_IZQ> 
                   | <PAREN_IZQ> ) )
        n = declaracionEstructura()                       { return n; }
      | LOOKAHEAD( [ <PUBLIC> | <PRIVATE> | <PROTECTED> | <INTERNAL> ] tipoDato() <IDENTIFICADOR> <LLAVE_IZQ> )
        n = propiedad()                                   { return n; }
      | LOOKAHEAD( llamadaMetodo() <PUNTO_COMA> )
        n = llamadaMetodo() <PUNTO_COMA>                  { return n; }
      | LOOKAHEAD({ esDeclaracion() })
        n = declaracion() <PUNTO_COMA>                   { return n; }
      | LOOKAHEAD(<IDENTIFICADOR> (<INCREMENTO> | <DECREMENTO>))
        n = sentenciaIncremento() <PUNTO_COMA>             { return n; }
      | LOOKAHEAD(<IDENTIFICADOR> (<SUMA_ASIG> | <RESTA_ASIG> | <MULT_ASIG> | <DIV_ASIG> | <MOD_ASIG>))
        n = asignacionCompuesta() <PUNTO_COMA>             { return n; }
      | LOOKAHEAD(2) n = asignacion() <PUNTO_COMA>        { return n; }
      | n = sentenciaIncremento() <PUNTO_COMA>            { return n; }
      | n = sentenciaBreak()                              { return n; }
      | n = sentenciaContinue()                           { return n; }
      | n = sentenciaReturn()                             { return n; }
      | n = sentenciaThrow()                              { return n; }
      | n = sentenciaTry()                                { return n; }
      | <PUNTO_COMA>                                      { return null; }
    )
}

/**
 * Bloque de código: { sentencia* }
 * Agrupa múltiples sentencias entre llaves.
 */
NodoBloque bloque() :
{
    Token t;
    NodoBloque blq;
    Nodo s;
}
{
    t = <LLAVE_IZQ>
    { blq = new NodoBloque(t.beginLine, t.beginColumn); }
    (
        try {
            s = sentencia()
            { if (s != null) blq.agregarSentencia(s); }
        } catch (ParseException e) {
            String encontrado = e.currentToken.next != null ? e.currentToken.next.image : "EOF";
            int linea = e.currentToken.next != null ? e.currentToken.next.beginLine : e.currentToken.beginLine;
            int columna = e.currentToken.next != null ? e.currentToken.next.beginColumn : e.currentToken.beginColumn;
            erroresSintacticos.add(new ErrorSintactico(encontrado, "...", e.getMessage(), linea, columna));
            recuperarErrorSintactico();
        }
    )*
    <LLAVE_DER>
    { return blq; }
}

/**
 * Sentencia if/else:
 *   if (expresion) bloque [else bloque | else if ...]
 */
Nodo sentenciaIf() :
{
    Token t;
    Nodo condicion;
    NodoBloque bloqueThen;
    Nodo bloqueElse = null;
}
{
    t = <IF>
    try {
        <PAREN_IZQ>
    } catch (ParseException e) {
        String encontrado = e.currentToken.next != null ? e.currentToken.next.image : "EOF";
        int linea = e.currentToken.next != null ? e.currentToken.next.beginLine : e.currentToken.beginLine;
        int columna = e.currentToken.next != null ? e.currentToken.next.beginColumn : e.currentToken.beginColumn;
        erroresSintacticos.add(new ErrorSintactico(encontrado, "(", "Se esperaba '(' después de 'if'", linea, columna));
    }
    
    try {
        condicion = expresion()
    } catch (ParseException e) {
        String encontrado = e.currentToken.next != null ? e.currentToken.next.image : "EOF";
        int linea = e.currentToken.next != null ? e.currentToken.next.beginLine : e.currentToken.beginLine;
        int columna = e.currentToken.next != null ? e.currentToken.next.beginColumn : e.currentToken.beginColumn;
        erroresSintacticos.add(new ErrorSintactico(encontrado, "condición", "Error en la condición del if", linea, columna));
        recuperarErrorSintactico();
        condicion = null;
    }

    try {
        <PAREN_DER>
    } catch (ParseException e) {
        String encontrado = e.currentToken.next != null ? e.currentToken.next.image : "EOF";
        int linea = e.currentToken.next != null ? e.currentToken.next.beginLine : e.currentToken.beginLine;
        int columna = e.currentToken.next != null ? e.currentToken.next.beginColumn : e.currentToken.beginColumn;
        erroresSintacticos.add(new ErrorSintactico(encontrado, ")", "Se esperaba ')' después de la condición", linea, columna));
    }

    try {
        bloqueThen = bloque()
    } catch (ParseException e) {
        String encontrado = e.currentToken.next != null ? e.currentToken.next.image : "EOF";
        int linea = e.currentToken.next != null ? e.currentToken.next.beginLine : e.currentToken.beginLine;
        int columna = e.currentToken.next != null ? e.currentToken.next.beginColumn : e.currentToken.beginColumn;
        erroresSintacticos.add(new ErrorSintactico(encontrado, "}", "Error en el bloque del if, probablemente falta '}'", linea, columna));
        bloqueThen = null;
    }

    [
        LOOKAHEAD(1)
        <ELSE>
        (
            LOOKAHEAD(<IF>)
            bloqueElse = sentenciaIf()
          | bloqueElse = bloque()
        )
    ]
    {
        return new NodoIf(condicion, bloqueThen, bloqueElse,
            t.beginLine, t.beginColumn);
    }
}

/**
 * Sentencia while: while (expresion) bloque
 */
Nodo sentenciaWhile() :
{
    Token t;
    Nodo condicion;
    NodoBloque cuerpo;
}
{
    t = <WHILE>
    <PAREN_IZQ>
    condicion = expresion()
    <PAREN_DER>
    cuerpo = bloque()
    {
        return new NodoWhile(condicion, cuerpo,
            t.beginLine, t.beginColumn);
    }
}

/**
 * Sentencia do-while: do bloque while (expresion);
 */
Nodo sentenciaDoWhile() :
{
    Token t;
    NodoBloque cuerpo;
    Nodo condicion;
}
{
    t = <DO>
    cuerpo = bloque()
    <WHILE>
    <PAREN_IZQ>
    condicion = expresion()
    <PAREN_DER>
    <PUNTO_COMA>
    {
        return new NodoDoWhile(cuerpo, condicion,
            t.beginLine, t.beginColumn);
    }
}

/**
 * Sentencia for: for ([init]; [condicion]; [actualizacion]) bloque
 *   init puede ser declaración o asignación
 *   actualizacion puede ser asignación o incremento/decremento
 */
Nodo sentenciaFor() :
{
    Token t;
    Nodo init = null;
    Nodo condicion = null;
    Nodo actualizacion = null;
    NodoBloque cuerpo;
}
{
    t = <FOR>
    <PAREN_IZQ>

    /* Inicialización (opcional) */
    [
        LOOKAHEAD(2) init = declaracion()
      | LOOKAHEAD(2) init = asignacion()
    ]
    <PUNTO_COMA>

    /* Condición (opcional) */
    [ condicion = expresion() ]
    <PUNTO_COMA>

    /* Actualización (opcional) */
    [
        LOOKAHEAD(<IDENTIFICADOR> (<INCREMENTO> | <DECREMENTO>))
        actualizacion = sentenciaIncremento()
      | LOOKAHEAD(<IDENTIFICADOR> (<SUMA_ASIG> | <RESTA_ASIG> | <MULT_ASIG> | <DIV_ASIG> | <MOD_ASIG>))
        actualizacion = asignacionCompuesta()
      | actualizacion = asignacion()
    ]

    <PAREN_DER>
    cuerpo = bloque()
    {
        return new NodoFor(init, condicion, actualizacion, cuerpo,
            t.beginLine, t.beginColumn);
    }
}

/**
 * Sentencia switch:
 *   switch (expresion) {
 *       case valor: sentencias... break;
 *       default: sentencias... break;
 *   }
 */
Nodo sentenciaSwitch() :
{
    Token t;
    Nodo expr;
    java.util.List<NodoCaso> casos = new java.util.ArrayList<NodoCaso>();
    NodoCaso caso;
}
{
    t = <SWITCH>
    <PAREN_IZQ>
    expr = expresion()
    <PAREN_DER>
    <LLAVE_IZQ>
    (
        caso = casoSwitch()
        { casos.add(caso); }
    )*
    <LLAVE_DER>
    {
        return new NodoSwitch(expr, casos, t.beginLine, t.beginColumn);
    }
}

/**
 * Un caso dentro de un switch:
 *   case valor: sentencia*
 *   default: sentencia*
 */
NodoCaso casoSwitch() :
{
    Token t;
    Nodo valor = null;
    boolean esDefault = false;
    java.util.List<Nodo> sentencias = new java.util.ArrayList<Nodo>();
    Nodo s;
}
{
    (
        t = <CASE>
        valor = expresion()
        <DOS_PUNTOS>
      |
        t = <DEFAULT_KW>
        <DOS_PUNTOS>
        { esDefault = true; }
    )
    (
        LOOKAHEAD( { getToken(1).kind != CASE && getToken(1).kind != DEFAULT_KW && getToken(1).kind != LLAVE_DER } )
        try {
            s = sentencia()
            { if (s != null) sentencias.add(s); }
        } catch (ParseException e) {
            String encontrado = e.currentToken.next != null ? e.currentToken.next.image : "EOF";
            int linea = e.currentToken.next != null ? e.currentToken.next.beginLine : e.currentToken.beginLine;
            int columna = e.currentToken.next != null ? e.currentToken.next.beginColumn : e.currentToken.beginColumn;
            erroresSintacticos.add(new ErrorSintactico(encontrado, "...", e.getMessage(), linea, columna));
            recuperarErrorSintactico();
        }
    )*
    {
        return new NodoCaso(valor, esDefault, sentencias,
            t.beginLine, t.beginColumn);
    }
}

/**
 * Sentencia de incremento/decremento: identificador++ o identificador--
 */
Nodo sentenciaIncremento() :
{
    Token id;
    Token op;
}
{
    id = <IDENTIFICADOR>
    ( op = <INCREMENTO> | op = <DECREMENTO> )
    {
        return new NodoIncremento(id.image, op.image,
            id.beginLine, id.beginColumn);
    }
}

/**
 * Asignación: identificador = expresión o identificador[expr] = expresión
 */
Nodo asignacion() :
{
    Nodo target;
    Nodo expr;
    java.util.List<Nodo> indices = new java.util.ArrayList<Nodo>();
}
{
    target = llamadaMetodo()
    (
        <CORCHETE_IZQ> expr = expresion() <CORCHETE_DER>
        { indices.add(expr); }
    )*
    <ASIGNACION>
    expr = expresion()
    {
        String varName = "";
        if (target instanceof NodoLlamadaMetodo) {
            varName = ((NodoLlamadaMetodo)target).getIdentificador();
        } else if (target instanceof NodoIdentificador) {
            varName = ((NodoIdentificador)target).getNombre();
        }
        
        if (indices.isEmpty()) {
            return new NodoAsignacion(varName, expr, target.getLinea(), target.getColumna());
        } else {
            // Representamos asignación a arreglo
            return new NodoAsignacion(varName + "[]", expr, target.getLinea(), target.getColumna());
        }
    }
}

/**
 * Sentencia break;
 */
Nodo sentenciaBreak() :
{
    Token t;
}
{
    t = <BREAK> <PUNTO_COMA>
    {
        return new NodoComando("break", null, t.beginLine, t.beginColumn);
    }
}

/**
 * Sentencia continue;
 */
Nodo sentenciaContinue() :
{
    Token t;
}
{
    t = <CONTINUE> <PUNTO_COMA>
    {
        return new NodoComando("continue", null, t.beginLine, t.beginColumn);
    }
}

/**
 * Sentencia return [expr];
 */
Nodo sentenciaReturn() :
{ Nodo expr = null; Token t; }
{
    t = <RETURN> [ expr = expresion() ] <PUNTO_COMA>
    { return new NodoComando("return", expr, t.beginLine, t.beginColumn); }
}

/**
 * Sentencia throw expr;
 */
Nodo sentenciaThrow() :
{ Nodo expr; Token t; }
{
    t = <THROW> expr = expresion() <PUNTO_COMA>
    { return new NodoComando("throw", expr, t.beginLine, t.beginColumn); }
}

/**
 * Sentencia try { ... } catch (...) { ... } finally { ... }
 */
Nodo sentenciaTry() :
{
    Token t;
    Nodo blqTry, blqCatch = null, blqFinally = null;
    Token tEx = null, idEx = null;
}
{
    t = <TRY> blqTry = bloque()
    (
        <CATCH> [ <PAREN_IZQ> [ tEx = tipoDato() idEx = <IDENTIFICADOR> ] <PAREN_DER> ]
        blqCatch = bloque()
    )*
    [
        <FINALLY> blqFinally = bloque()
    ]
    {
        return new NodoComando("try", blqTry, t.beginLine, t.beginColumn);
    }
}

/**
 * Declaración: tipo identificador [= expresión]
 * Ejemplo: int x; o int x = 5 + 3;
 */
Nodo declaracion() :
{
    Token tipo;
    Token id;
    Nodo expr = null;
    java.util.List<Nodo> listaNodos = new java.util.ArrayList<Nodo>();
    boolean isConst = false;
}
{
    ( <PUBLIC> | <PRIVATE> | <PROTECTED> | <INTERNAL> | <STATIC> | <VIRTUAL> | <OVERRIDE> | <CONST> { isConst = true; } | <READONLY> )*
    tipo = tipoDato()
    
    id = <IDENTIFICADOR>
    [
        <ASIGNACION>
        (
            <LLAVE_IZQ> { expr = new NodoArreglo(tipo.image, "0", tipo.beginLine, tipo.beginColumn); }
            [ listaValoresArreglo() ] <LLAVE_DER>
          | expr = expresion()
        )
    ]
    {
        NodoDeclaracion nd = new NodoDeclaracion(tipo.image, id.image, expr, tipo.beginLine, tipo.beginColumn);
        listaNodos.add(nd);
    }
    (
        <COMA> id = <IDENTIFICADOR>
        { expr = null; }
        [
            <ASIGNACION>
            (
                <LLAVE_IZQ> { expr = new NodoArreglo(tipo.image, "0", tipo.beginLine, tipo.beginColumn); }
                [ listaValoresArreglo() ] <LLAVE_DER>
              | expr = expresion()
            )
        ]
        {
            NodoDeclaracion nd2 = new NodoDeclaracion(tipo.image, id.image, expr, id.beginLine, id.beginColumn);
            listaNodos.add(nd2);
        }
    )*
    
    {
        if (listaNodos.size() == 1) return listaNodos.get(0);
        NodoBloque bloqueDecl = new NodoBloque(tipo.beginLine, tipo.beginColumn);
        for (Nodo n : listaNodos) {
            bloqueDecl.agregarSentencia(n);
        }
        return bloqueDecl;
    }
}

/**
 * Propiedad: tipo identificador { get; set; }
 */
Nodo propiedad() :
{
    Token tipo;
    Token id;
}
{
    ( <PUBLIC> | <PRIVATE> | <PROTECTED> | <INTERNAL> | <STATIC> | <VIRTUAL> | <OVERRIDE> | <CONST> | <READONLY> )*
    tipo = tipoDato() id = <IDENTIFICADOR>
    <LLAVE_IZQ> 
    ( 
        [ <PUBLIC> | <PRIVATE> | <PROTECTED> | <INTERNAL> ] 
        <IDENTIFICADOR> 
        ( <PUNTO_COMA> | bloque() ) 
    )* 
    <LLAVE_DER>
    {
        return new NodoDeclaracion(tipo.image, id.image, null, tipo.beginLine, tipo.beginColumn);
    }
}

void listaValoresArreglo() :
{}
{
    expresion() ( <COMA> expresion() )*
}

/**
 * Asignación compuesta: identificador += expresión, -=, *=, /=, %=
 */
Nodo asignacionCompuesta() :
{
    Token id;
    Token op;
    Nodo expr;
}
{
    id = <IDENTIFICADOR>
    ( op = <SUMA_ASIG> | op = <RESTA_ASIG> | op = <MULT_ASIG> | op = <DIV_ASIG> | op = <MOD_ASIG> )
    expr = expresion()
    {
        String opBase = op.image.substring(0, op.image.length() - 1);
        Nodo izq = new NodoIdentificador(id.image, id.beginLine, id.beginColumn);
        Nodo operacion = new NodoOperacion(izq, opBase, expr, op.beginLine, op.beginColumn);
        return new NodoAsignacion(id.image, operacion, id.beginLine, id.beginColumn);
    }
}

/**
 * Llamada a método genérica o acceso a propiedad: obj.Metodo(args) o obj.Propiedad
 */
Nodo llamadaMetodo() :
{
    Token t;
    StringBuilder id = new StringBuilder();
    java.util.List<Nodo> args = new java.util.ArrayList<Nodo>();
    boolean isMethod = false;
}
{
    ( t = tipoDatoBase() | t = <BASE> | t = <THIS> )
    { id.append(t.image); }
    (
        <PUNTO> t = <IDENTIFICADOR>
        { id.append(".").append(t.image); }
    )*
    [
        <PAREN_IZQ>
        [ args = listaArgumentos() ]
        <PAREN_DER>
        { isMethod = true; }
    ]
    { 
        if (isMethod) {
            return new NodoLlamadaMetodo(id.toString(), args, t != null ? t.beginLine : 0, 0); 
        } else {
            return new NodoIdentificador(id.toString(), t != null ? t.beginLine : 0, 0);
        }
    }
}

java.util.List<Nodo> listaArgumentos() :
{
    java.util.List<Nodo> args = new java.util.ArrayList<Nodo>();
    Nodo expr;
}
{
    [ <OUT> | <REF> ] expr = expresion() { args.add(expr); }
    (
        <COMA> [ <OUT> | <REF> ] expr = expresion() { args.add(expr); }
    )*
    { return args; }
}

/**
 * Estructuras de clases, namespaces, etc.
 */
Nodo declaracionEstructura() :
{
    Token t = null;
    Token id = null;
    NodoBloque blq = null;
}
{
    (
        t = <NAMESPACE> id = <IDENTIFICADOR> blq = bloque()
        { return new NodoEstructura("namespace", id.image, t.beginLine, t.beginColumn); }
      | t = <USING> id = <IDENTIFICADOR>
        ( <PUNTO> <IDENTIFICADOR> )* <PUNTO_COMA>
        { return new NodoEstructura("using", id.image, t.beginLine, t.beginColumn); }
      | ( <PUBLIC> | <PRIVATE> | <PROTECTED> | <INTERNAL> | <STATIC> | <VIRTUAL> | <OVERRIDE> | <CONST> | <READONLY> )*
        (
            t = <CLASS> 
            (
                try {
                    id = <IDENTIFICADOR> [ <DOS_PUNTOS> <IDENTIFICADOR> ( <COMA> <IDENTIFICADOR> )* ]
                } catch (ParseException e) {
                    recuperarHastaLlave(e, "Se esperaba el nombre de la clase o herencia válida");
                }
            )
            blq = bloque()
            { return new NodoEstructura("class", id != null ? id.image : "error", t.beginLine, t.beginColumn); }
          | t = <INTERFACE> 
            (
                try {
                    id = <IDENTIFICADOR> [ <DOS_PUNTOS> <IDENTIFICADOR> ( <COMA> <IDENTIFICADOR> )* ]
                } catch (ParseException e) {
                    recuperarHastaLlave(e, "Se esperaba el nombre de la interfaz o herencia válida");
                }
            )
            blq = bloque()
            { return new NodoEstructura("interface", id != null ? id.image : "error", t.beginLine, t.beginColumn); }
          | t = <ENUM> 
            (
                try {
                    id = <IDENTIFICADOR> 
                } catch (ParseException e) {
                    recuperarHastaLlave(e, "Se esperaba el nombre del enumerador");
                }
            )
            <LLAVE_IZQ> 
            [ <IDENTIFICADOR> ( <COMA> <IDENTIFICADOR> )* ] 
            <LLAVE_DER>
            { return new NodoEstructura("enum", id != null ? id.image : "error", t.beginLine, t.beginColumn); }
          | LOOKAHEAD( tipoDato() <OPERATOR> )
            tipoDato() <OPERATOR> ( <IGUAL> | <DIFERENTE> | <SUMA> | <RESTA> | <MULT> | <DIV> )
            <PAREN_IZQ> [ parametros() ] <PAREN_DER> blq = bloque()
            { return new NodoEstructura("operator", "op", t != null ? t.beginLine : 0, 0); }
          | LOOKAHEAD( ( <VOID> | tipoDato() ) <IDENTIFICADOR> )
            ( <VOID> | tipoDato() ) 
            (
                try {
                    id = <IDENTIFICADOR> <PAREN_IZQ> [ parametros() ] <PAREN_DER> 
                } catch (ParseException e) {
                    recuperarHastaLlave(e, "Se esperaba el nombre del método y sus parámetros");
                }
            )
            ( blq = bloque() | <PUNTO_COMA> )
            { return new NodoEstructura("method", id != null ? id.image : "error", id != null ? id.beginLine : 0, id != null ? id.beginColumn : 0); }
          | LOOKAHEAD( <IDENTIFICADOR> <PAREN_IZQ> )
            (
                try {
                    id = <IDENTIFICADOR> <PAREN_IZQ> [ parametros() ] <PAREN_DER> 
                    [ <DOS_PUNTOS> ( <BASE> | <THIS> ) <PAREN_IZQ> [ listaArgumentos() ] <PAREN_DER> ]
                } catch (ParseException e) {
                    recuperarHastaLlave(e, "Se esperaba la firma del constructor");
                }
            )
            ( blq = bloque() | <PUNTO_COMA> )
            { return new NodoEstructura("constructor", id != null ? id.image : "error", id != null ? id.beginLine : 0, id != null ? id.beginColumn : 0); }
          | LOOKAHEAD( <PAREN_IZQ> )
            (
                try {
                    <PAREN_IZQ> [ parametros() ] <PAREN_DER> 
                } catch (ParseException e) {
                    recuperarHastaLlave(e, "Se esperaba la firma del método o constructor");
                }
            )
            ( blq = bloque() | <PUNTO_COMA> )
            { return new NodoEstructura("method", "error", t != null ? t.beginLine : 0, t != null ? t.beginColumn : 0); }
        )
    )
}

void parametros() :
{}
{
    tipoDato() <IDENTIFICADOR> [ <ASIGNACION> expresion() ] 
    ( <COMA> tipoDato() <IDENTIFICADOR> [ <ASIGNACION> expresion() ] )*
}

/* ── Jerarquía de expresiones (de menor a mayor precedencia) ── */

/**
 * Expresión: maneja el operador ternario (? :).
 */
Nodo expresion() :
{
    Nodo cond;
    Nodo verdadero = null;
    Nodo falso = null;
    Token t = null;
}
{
    cond = expresionOr()
    [
        t = <INTERROGACION> verdadero = expresion() <DOS_PUNTOS> falso = expresion()
      | t = <NULL_COALESCING> verdadero = expresion() { falso = null; }
    ]
    {
        if (t != null) {
            return new NodoTernario(cond, verdadero, falso, t.beginLine, t.beginColumn);
        }
        return cond;
    }
}

/**
 * Expresión OR: maneja el operador lógico OR (||).
 */
Nodo expresionOr() :
{
    Nodo izq;
    Nodo der;
    Token op;
}
{
    izq = expresionAnd()
    (
        op = <OR>
        der = expresionAnd()
        {
            izq = new NodoOperacionLogica(
                izq, op.image, der,
                op.beginLine, op.beginColumn
            );
        }
    )*
    { return izq; }
}

/**
 * Expresión AND: maneja el operador lógico AND (&&).
 */
Nodo expresionAnd() :
{
    Nodo izq;
    Nodo der;
    Token op;
}
{
    izq = expresionIgualdad()
    (
        op = <AND>
        der = expresionIgualdad()
        {
            izq = new NodoOperacionLogica(
                izq, op.image, der,
                op.beginLine, op.beginColumn
            );
        }
    )*
    { return izq; }
}

/**
 * Expresión de igualdad: maneja == y !=.
 */
Nodo expresionIgualdad() :
{
    Nodo izq;
    Nodo der;
    Token op;
}
{
    izq = expresionRelacional()
    (
        ( op = <IGUAL> | op = <DIFERENTE> )
        der = expresionRelacional()
        {
            izq = new NodoOperacionRelacional(
                izq, op.image, der,
                op.beginLine, op.beginColumn
            );
        }
    )*
    { return izq; }
}

/**
 * Expresión relacional: maneja <, >, <=, >=.
 */
Nodo expresionRelacional() :
{
    Nodo izq;
    Nodo der;
    Token op;
}
{
    izq = expresionAditiva()
    (
        ( op = <MENOR> | op = <MAYOR> | op = <MENOR_IGUAL> | op = <MAYOR_IGUAL> )
        der = expresionAditiva()
        {
            izq = new NodoOperacionRelacional(
                izq, op.image, der,
                op.beginLine, op.beginColumn
            );
        }
    )*
    { return izq; }
}

/**
 * Expresión aditiva: maneja suma (+) y resta (-).
 */
Nodo expresionAditiva() :
{
    Nodo izq;
    Nodo der;
    Token op;
}
{
    izq = termino()
    (
        ( op = <SUMA> | op = <RESTA> )
        der = termino()
        {
            izq = new NodoOperacion(
                izq, op.image, der,
                op.beginLine, op.beginColumn
            );
        }
    )*
    { return izq; }
}

/**
 * Término: maneja multiplicación, división y módulo.
 */
Nodo termino() :
{
    Nodo izq;
    Nodo der;
    Token op;
}
{
    izq = factor()
    (
        ( op = <MULT> | op = <DIV> | op = <MOD> )
        der = factor()
        {
            izq = new NodoOperacion(
                izq, op.image, der,
                op.beginLine, op.beginColumn
            );
        }
    )*
    { return izq; }
}

/**
 * Factor: unidad atómica de una expresión.
 * Puede ser: número, identificador, cadena, booleano, o expresión entre paréntesis.
 */
Nodo factor() :
{
    Token t;
    Nodo n;
    Nodo n2 = null;
    Token signo = null;
}
{
    (
      LOOKAHEAD( llamadaMetodo() <CORCHETE_IZQ> )
        n = llamadaMetodo() <CORCHETE_IZQ> n2 = expresion() <CORCHETE_DER>
        { 
            String varName = "";
            if (n instanceof NodoLlamadaMetodo) varName = ((NodoLlamadaMetodo)n).getIdentificador();
            else if (n instanceof NodoIdentificador) varName = ((NodoIdentificador)n).getNombre();
            return new NodoAccesoArreglo(varName, n2, 0, 0); 
        }
      | LOOKAHEAD( llamadaMetodo() ( <INCREMENTO> | <DECREMENTO> ) )
        n = llamadaMetodo() ( signo = <INCREMENTO> | signo = <DECREMENTO> )
        {
            String varName = "";
            if (n instanceof NodoLlamadaMetodo) varName = ((NodoLlamadaMetodo)n).getIdentificador();
            else if (n instanceof NodoIdentificador) varName = ((NodoIdentificador)n).getNombre();
            return new NodoIncremento(varName, signo.image, 0, 0);
        }
      | LOOKAHEAD( ( <INCREMENTO> | <DECREMENTO> ) llamadaMetodo() )
        ( signo = <INCREMENTO> | signo = <DECREMENTO> ) n = llamadaMetodo()
        {
            String varName = "";
            if (n instanceof NodoLlamadaMetodo) varName = ((NodoLlamadaMetodo)n).getIdentificador();
            else if (n instanceof NodoIdentificador) varName = ((NodoIdentificador)n).getNombre();
            return new NodoIncremento(varName, signo.image, 0, 0);
        }
      | LOOKAHEAD( llamadaMetodo() )
        n = llamadaMetodo()
        { return n; }
      | LOOKAHEAD( <PAREN_IZQ> tipoDato() <PAREN_DER> )
        <PAREN_IZQ> t = tipoDato() <PAREN_DER> n = factor()
        { return new NodoCasteo(t.image, n, t.beginLine, t.beginColumn); }
      | <NEW> t = tipoDato() 
        (
            LOOKAHEAD( <CORCHETE_IZQ> )
            <CORCHETE_IZQ> n = expresion() <CORCHETE_DER>
            [ <LLAVE_IZQ> [ listaValoresArreglo() ] <LLAVE_DER> ]
            { return new NodoInstanciacion(t.image, n, t.beginLine, t.beginColumn); }
          | { java.util.List<Nodo> argList = new java.util.ArrayList<Nodo>(); }
            [ <PAREN_IZQ> [ argList = listaArgumentos() ] <PAREN_DER> ]
            [ <LLAVE_IZQ> [ listaValoresArreglo() ] <LLAVE_DER> ]
            { return new NodoInstanciacion(t.image, argList, t.beginLine, t.beginColumn); }
        )
      | [ signo = <RESTA> ]
        (
            t = <NUMERO_ENTERO>
            { return new NodoNumero((signo != null ? "-" : "") + t.image, (signo != null ? signo.beginLine : t.beginLine), (signo != null ? signo.beginColumn : t.beginColumn)); }
          | t = <NUMERO_DECIMAL>
            { return new NodoNumero((signo != null ? "-" : "") + t.image, (signo != null ? signo.beginLine : t.beginLine), (signo != null ? signo.beginColumn : t.beginColumn)); }
          | t = <NUMERO_ENTERO_NEGATIVO>
            { return new NodoNumero((signo != null ? "-" : "") + t.image, (signo != null ? signo.beginLine : t.beginLine), (signo != null ? signo.beginColumn : t.beginColumn)); }
          | t = <NUMERO_DECIMAL_NEGATIVO>
            { return new NodoNumero((signo != null ? "-" : "") + t.image, (signo != null ? signo.beginLine : t.beginLine), (signo != null ? signo.beginColumn : t.beginColumn)); }
        )
      | t = <IDENTIFICADOR>
        { return new NodoIdentificador(t.image, t.beginLine, t.beginColumn); }
      | t = <CADENA>
        {
            String val = t.image.substring(1, t.image.length() - 1);
            return new NodoCadena(val, t.beginLine, t.beginColumn);
        }
      | t = <CADENA_VERBATIM>
        {
            String val = t.image.substring(2, t.image.length() - 1);
            val = val.replace("\"\"", "\"");
            return new NodoCadena(val, t.beginLine, t.beginColumn);
        }
      | t = <CARACTER>
        {
            String charVal = t.image.substring(1, t.image.length() - 1);
            return new NodoCadena(charVal, t.beginLine, t.beginColumn);
        }
      | t = <TRUE>
        { return new NodoBooleano(true, t.beginLine, t.beginColumn); }
      | t = <FALSE>
        { return new NodoBooleano(false, t.beginLine, t.beginColumn); }
      | t = <NULL>
        { return new NodoIdentificador("null", t.beginLine, t.beginColumn); }
      | t = <NOT>
        n = factor()
        { return new NodoNegacionLogica(n, t.beginLine, t.beginColumn); }
      | <PAREN_IZQ>
        n = expresion()
        <PAREN_DER>
        { return new NodoAgrupacion(n, n.getLinea(), n.getColumna()); }
    )
}

/**
 * Reconoce un tipo de dato base y devuelve el token.
 */
Token tipoDatoBase() :
{
    Token t;
}
{
    (
        t = <INT>
      | t = <FLOAT>
      | t = <DOUBLE>
      | t = <BOOL>
      | t = <STRING_T>
      | t = <CHAR_T>
      | t = <VOID>
      | t = <BYTE>
      | t = <SBYTE>
      | t = <SHORT>
      | t = <USHORT>
      | t = <UINT>
      | t = <LONG>
      | t = <ULONG>
      | t = <DECIMAL>
      | t = <OBJECT>
      | t = <VAR>
      | t = <IDENTIFICADOR>
    )
    { return t; }
}

/**
 * Reconoce un tipo de dato y devuelve el token.
 */
Token tipoDato() :
{
    Token t;
}
{
    t = tipoDatoBase()
    [ <INTERROGACION> { t.image += "?"; } ]
    [ LOOKAHEAD(2) <MENOR> tipoDato() ( <COMA> tipoDato() )* <MAYOR> { t.image += "<...>"; } ]
    [ LOOKAHEAD(2) <CORCHETE_IZQ> <CORCHETE_DER> { t.image += "[]"; } ]
    { return t; }
}